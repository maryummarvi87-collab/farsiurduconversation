 "grammar": [
  {
   "title": "ضمائر (ضمیرها)",
   "body": "من — میں\nتو — تو / تم\nاو — وہ\nما — ہم\nشما — آپ / تم\nآن‌ها — وہ سب (ایشان: احتراماً)\n\nنوٹ: فارسی میں مذکر اور مؤنث کا فرق نہیں ہوتا۔ «او» مرد اور عورت دونوں کے لیے آتا ہے۔"
  },
  {
   "title": "فعل «بودن» (ہونا)",
   "body": "حال:\nمن هستم — میں ہوں\nتو هستی — تم ہو\nاو است — وہ ہے\nما هستیم — ہم ہیں\nشما هستید — آپ ہیں\nآن‌ها هستند — وہ ہیں\n\nماضی:\nبودم، بودی، بود، بودیم، بودید، بودند\n\nمنفی:\nنیستم، نیستی، نیست، نیستیم، نیستید، نیستند\n\nمختصر شکل: «خوبم» یعنی «خوب هستم» (میں اچھا ہوں)۔"
  },
  {
   "title": "فعل حال: می‌ + مادہ + شناسہ",
   "body": "بنانے کا طریقہ: «می‌» + مضارع کا مادہ + ضمیر کی علامت\n\nمصدر «رفتن» (جانا)، مادہ «رو»:\nمی‌روم — میں جاتا ہوں\nمی‌روی — تم جاتے ہو\nمی‌رود — وہ جاتا ہے\nمی‌رویم — ہم جاتے ہیں\nمی‌روید — آپ جاتے ہیں\nمی‌روند — وہ جاتے ہیں\n\nمثال: «می‌نویسم» — میں لکھتا ہوں (نوشتن ← مادہ نویس)۔"
  },
  {
   "title": "ماضی سادہ",
   "body": "مصدر کے آخر سے «ـن» ہٹا دیں تو ماضی کا مادہ بن جاتا ہے، پھر علامتیں لگائیں:\n\nرفتن ← رفت:\nرفتم، رفتی، رفت، رفتیم، رفتید، رفتند\n\nمثال: «دیروز به بازار رفتم» — کل میں بازار گیا۔\n\nماضی استمراری: «می‌» + ماضی: می‌رفتم — میں جایا کرتا تھا۔"
  },
  {
   "title": "جمع بنانا",
   "body": "ـها — عام اور بے جان چیزوں کے لیے: کتاب‌ها (کتابیں)، خانه‌ها (گھر)\nـان — عموماً جان داروں کے لیے: دانشجویان (طلبہ)، مردان (مرد)\nـات — عربی الفاظ میں: کلمات، معلومات\n\nنوٹ: گنتی کے بعد اسم عموماً واحد رہتا ہے: «سه کتاب» (تین کتابیں)۔"
  },
  {
   "title": "کسرۂ اضافت",
   "body": "دو لفظوں کو جوڑنے کے لیے پہلے لفظ کے آخر میں زیر (ـِ) کی آواز آتی ہے۔ عموماً یہ لکھی نہیں جاتی، صرف بولی جاتی ہے۔\n\nکتابِ من — میری کتاب\nخانهٔ دوست — دوست کا گھر\nدخترِ زیبا — خوبصورت لڑکی\n\nجب لفظ ہ پر ختم ہو تو «ـهٔ» لکھتے ہیں؛ جب ا یا و پر ختم ہو تو «ـیِ» کی آواز بڑھتی ہے: دانشجوی من (میرا طالب علم)۔"
  },
  {
   "title": "علامتِ مفعول «را»",
   "body": "جب مفعول متعین ہو تو اس کے بعد «را» آتا ہے:\n\nکتاب را می‌خوانم — میں (وہ) کتاب پڑھتا ہوں۔\nعلی را دیدم — میں نے علی کو دیکھا۔\n\nفعل جملے کے آخر میں آتا ہے، بالکل اردو کی طرح:\nمن نان می‌خورم — میں روٹی کھاتا ہوں۔"
  }
 ],
